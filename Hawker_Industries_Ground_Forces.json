    "sharedRules": [
      {
        "name": "Artillery_Support(2)",
        "id": "e6fc0961-ace1-c55e-b401-4acca8ef380f",
        "description": "May use the Artillery Support rules on Page 82.",
        "hidden": false,
        "page": 116,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Command_Element(16\")",
        "id": "78d324e1-26b5-599c-6902-cadeeef9985c",
        "description": "All helix squadrons in 16\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Flying_Vehicle",
        "id": "501a8e86-3401-faef-7aff-9f1094200595",
        "description": "When moving at Cruising Speed the unit gains Hard Target (-1), when moving at Flat Out the unit gains Hard Target (-2).",
        "hidden": false,
        "page": 118,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Ground_Attack",
        "id": "29d9-0d96-60ff-510f",
        "description": "This Squadron may fire its Main Ordnance while moving Flat Out provided the target squadron are Surface models. These shots are considered to be Rushed.",
        "hidden": false,
        "page": 10,
        "publicationId": "0610-e4cd-pub2"
      },
      {
        "name": "Legacy_Through_Fortitude",
        "id": "a2aa82e1-7bf4-e124-39ab-b4615695055e",
        "description": "All Hawker Industries Armoured adn Aerial elements may attempt to remove a single point of Damage from each Squadron during the Repair Segment of the End Phase on the roll of a 4+.",
        "hidden": false,
        "page": 2,
        "publicationId": "0610-e4cd-pub3"
      },
      {
        "name": "Logistics_Points",
        "id": "165a2748-17cf-41f6-039e-98d07da4d54a",
        "description": "May use up to 5 points to bid on an Opposed Tactics test.",
        "hidden": false,
        "page": 58,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Multipurpose_Assault",
        "id": "61bddc41-0441-5f4d-2773-89dc5a700c7c",
        "description": "This Squadron may fire its Main Ordnance while moving Flat Out. These shots are considered to be Rushed.",
        "hidden": false,
        "page": 10,
        "publicationId": "0610-e4cd-pub4"
      },
      {
        "name": "Overwatch_Capable",
        "id": "d10b-7f9b-d475-e54d",
        "description": "This Model may be placed on Overwatch using Logistics Points at the start of a Game Turn. It costs 3 Logistics Points to put this Model in Overwatch",
        "hidden": false
      },
      {
        "name": "Recon_Specialist",
        "id": "8774c1ed-d743-feda-ac5e-58258e685dec",
        "description": "May move in the Recon Phase.",
        "hidden": false,
        "page": 120,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Sectored_Armour",
        "id": "1126-1b44-48ca-a3b7",
        "description": "Model never suffers penalties to DR from Flank or Aft Main Ordnance attacks.",
        "hidden": false,
        "page": 121,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Take_&_Hold",
        "id": "a12256c4-fb47-7fca-9af4-a413c5387d63",
        "description": "This unit may claim objectives.",
        "hidden": false,
        "page": 121,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Tracked/Wheeled_Vehicle",
        "id": "4e3ac4b5-c681-822a-31cc-b829972c8fd6",
        "description": "Impassible Terrain : Vegetation/Forests/Jungle, Huge Rocks/Spires, Rivers (Non Lethal), Walkway (Buildings Only).\nMay not Flat Out over Rough Ground / Craters.\nIncrease Movement by 3\" on  Roads.",
        "hidden": false,
        "page": 122,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Transport(9)",
        "id": "ad0a4ad2-e83a-de34-51c9-ea59b788289a",
        "description": "May act as a transport for 9 slots worth of Infantry.",
        "hidden": false,
        "page": 122,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Anti-Personnel",
        "id": "d94bfcdd-e185-0337-aad7-c7bbd7b1b8ce",
        "description": "Weapon ignores Hard Target rules when targeting Infantry.",
        "hidden": false,
        "page": 116,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Barrage",
        "id": "33b6e081-d57d-37ec-141a-8005f443649c",
        "description": "Models targeted by a Barrage weapon do not receive cover saves.",
        "hidden": false,
        "page": 116,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Corrosive",
        "id": "8ed47ace-e091-ff8d-c8b2-c8e68670b620",
        "description": "Models damaged by this weapon, but not destroyed receive a Debilitating Effect Marker. These markets give -1 DR until repaired. Multiple Markers may be placed, but the effect is not cumulative.",
        "hidden": false,
        "page": 116,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Interceptor",
        "id": "fa6a026d-b99b-78e4-9187-1778fab44641",
        "description": "Flying targets do not gain the benefit of Hard Target against these weapons.",
        "hidden": false,
        "page": 119,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Nexus_Designator",
        "id": "9fc80aca-61a6-7e09-cd30-760244644f3d",
        "description": "Weapon is used to reduce Sky Drop Markers micro dice.",
        "hidden": false,
        "page": 79,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Pinpoint(1)",
        "id": "34197a14-0bc0-8cfd-d73b-4d3a7ebf8a2f",
        "description": "If a Pinpoint weapon damages, but fails to destroy non-infantry, roll 1d6. If one or more 6's are rolled, the target suffers an additional point of damage. If multiple weapons combine with Pinpoint, use the highest value only.",
        "hidden": false,
        "page": 119,
        "publicationId": "0610-e4cd-pub1"
      },
      {
        "name": "Weapon_MAR:Terror_Weapon",
        "id": "de5b2eaa-1c18-3a7a-31ae-c81487b5f5bd",
        "description": "Disorder Tests caused by this weapon roll one less die.",
        "hidden": false,
        "page": 122,
        "publicationId": "0610-e4cd-pub1"
      }
    ],
