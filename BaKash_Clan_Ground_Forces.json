    "sharedRules": [
      {
        "name": "Apex_Predators",
        "id": "ce26cd29-4c63-94b0-b7bd-3b3e47bb4103",
        "description": "All Ba’Kash Aerial and Light elements have the Recon Specialist MAR.",
        "hidden": false,
        "page": 2,
        "publicationId": "80a9-5f12-pub1"
      },
      {
        "name": "Command_Element(12\")",
        "id": "78d324e1-26b5-599c-6902-cadeeef9985c",
        "description": "All helix squadrons in 12\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Fearless",
        "id": "181a03e8-a501-b720-01fb-ad6ad2a97200",
        "description": "Unit never takes Disordered Tests.",
        "hidden": false,
        "page": 118,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Flying_Vehicle",
        "id": "501a8e86-3401-faef-7aff-9f1094200595",
        "description": "When moving at Cruising Speed the unit gains Hard Target (-1), when moving at Flat Out the unit gains Hard Target (-2).",
        "hidden": false,
        "page": 118,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Ground_Attack",
        "id": "61bddc41-0441-5f4d-2773-89dc5a700c7c",
        "description": "This squadron may fire its Main Ordnance while moving Flat Out, but may only target Surface models. These shots are considered to be Rushed.",
        "hidden": false,
        "page": 10,
        "publicationId": "80a9-5f12-pub3"
      },
      {
        "name": "Logistics_Points",
        "id": "165a2748-17cf-41f6-039e-98d07da4d54a",
        "description": "May use up to 4 points to bid on an Opposed Tactics test.",
        "hidden": false,
        "page": 58,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Sectored_Armour",
        "id": "12d9-b68d-cf09-2d66",
        "description": "Model never suffers penalties to DR from Flank or Aft Main Ordnance attacks.",
        "hidden": false,
        "page": 121,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Weapon_MAR:Anti-Personnel",
        "id": "d94bfcdd-e185-0337-aad7-c7bbd7b1b8ce",
        "description": "Weapon ignores Hard Target rules when targeting Infantry.",
        "hidden": false,
        "page": 116,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Weapon_MAR:Barrage",
        "id": "33b6e081-d57d-37ec-141a-8005f443649c",
        "description": "Models targeted by a Barrage weapon do not receive cover saves.",
        "hidden": false,
        "page": 116,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Weapon_MAR:Scatter",
        "id": "796c596b-4df4-8aa5-c7db-e26ec670a62d",
        "description": "Scatter Weapons ignore any negative modifiers from the Hard Taret MAR when firing at non-flying Targets.",
        "hidden": false,
        "page": 121,
        "publicationId": "80a9-5f12-pub2"
      },
      {
        "name": "Weapon_MAR:Terror_Weapon",
        "id": "de5b2eaa-1c18-3a7a-31ae-c81487b5f5bd",
        "description": "Disorder Tests caused by this weapon roll one less die.",
        "hidden": false,
        "page": 122,
        "publicationId": "80a9-5f12-pub2"
      }
    ],
