    "sharedRules": [
      {
        "name": "Bulky(2)",
        "id": "d105d61e-c64a-99f7-bbc7-8a2c84a995d8",
        "description": "These units take up 2 slots in transports.",
        "hidden": false,
        "page": 116,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Command_Element(18\")",
        "id": "92ad4a2c-9359-fc2a-2fd4-e8c6c01e40b7",
        "description": "All helix squadrons in 18\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Drone",
        "id": "336a2f30-3ea0-3651-1b3c-2277057aa8c3",
        "description": "Drones within range of a Drone Nexus become Regular and gain +1 CQB.",
        "hidden": false,
        "page": 117,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Drone_Nexus(8\")",
        "id": "fcd755dd-6502-37aa-a0f4-588907a2b5c2",
        "description": "Boosts Drones to Regular and gives them +1 CQB within 8\". Each point of damage lowers the Nexus range by 4\".",
        "hidden": false,
        "page": 117,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Fearless",
        "id": "0654a0ed-a564-f83d-778a-cca3a6640806",
        "description": "Unit never takes Disordered Tests.",
        "hidden": false,
        "page": 118,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Flying_Vehicle",
        "id": "84c7c112-99e0-51d5-5c33-f215b285db0c",
        "description": "When moving at Cruising Speed the unit gains Hard Target (-1), when moving at Flat Out the unit gains Hard Target (-2).",
        "hidden": false,
        "page": 118,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Ground_Attack",
        "id": "6721-4bad-1932-7fb7",
        "description": "This Squadron may fire its Main Ordnance while moving Flat Out provided the target squadron are Surface models – These shots are considered to be Rushed.",
        "hidden": false,
        "page": 7,
        "publicationId": "cd17-5d57-pub2"
      },
      {
        "name": "Hard_Target(-1)",
        "id": "fa16c08c-56d5-2bf8-49c0-66d4d99b48b9",
        "description": "Main Ordnance is -1 to hit this unit.",
        "hidden": false,
        "page": 118,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Logistics_Points",
        "id": "924ab8ac-3403-bcea-a341-c71e58c2e6ee",
        "description": "May use up to 4 points to bid on an Opposed Tactics test.",
        "hidden": false,
        "page": 58,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Portal_Capable",
        "id": "66ea-ea88-9d43-44c6",
        "description": "This Squadron may make use of Temporal Portals.",
        "hidden": false,
        "page": 11,
        "publicationId": "cd17-5d57-pub3"
      },
      {
        "name": "Portal_Technology(Nabis_Drones_Only)",
        "id": "4cdda248-fbaa-0c30-608f-2ab1677ea2d1",
        "description": "Nabis Drones may use these portals as per Page 82 of the Core Rulebook.",
        "hidden": false,
        "page": 82,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Rear_Echelon",
        "id": "5134434e-bc4c-b8b4-1c31-81873e0eef3d",
        "description": "A model with this MAR is considered to be activated on the turn it is deployed.",
        "hidden": false,
        "page": 120,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Sectored_Armour",
        "id": "05bd-2760-daf6-3a3e",
        "description": "Model never suffers penalties to DR from Flank or Aft Main Ordnance attacks.",
        "hidden": false,
        "page": 121,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Sky_Drop",
        "id": "41458ec0-7191-91b6-cdc1-d7ea05150f98",
        "description": "May use the Sky Drop Deployment rules on Page 79.",
        "hidden": false,
        "page": 121,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Sky_Drop_Asset",
        "id": "61ce68cc-7a35-94d5-876b-4f104b1dc706",
        "description": "Unless otherwise noted, this model MUST deploy via Sky Drop. (Page 79 of Core Rulebook)",
        "hidden": false
      },
      {
        "name": "Sky_Drop_Nexus(Temporal_Portals_Only,_2)",
        "id": "4fddf1fa-4639-8539-da44-031c2eaa9f9d",
        "description": "Places 2 Drop Site Markers for Temporal Portals in the Place Drop-Sites Segment of the Pre-Game Phase.",
        "hidden": false,
        "page": 121,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Take_&_Hold",
        "id": "7490be39-1253-267f-bd1a-eb0a1c31a85a",
        "description": "This unit may claim objectives.",
        "hidden": false,
        "page": 121,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Temporal_Shift",
        "id": "4370584d-26b1-ffc5-66ba-bc49902295ab",
        "description": "All Terquai Empire Armoured and Aerial elements may gain the Cloaked MAR at the end of their Activation provided they do not engage in CQB or perform any Main Ordnance Firing during their Activation. The Cloaked MAR lasts until the beginning of their next Activation.",
        "hidden": false,
        "page": 2,
        "publicationId": "cd17-5d57-pub4"
      },
      {
        "name": "Weapon_MAR:Anti-Personnel",
        "id": "18268857-4ffe-7ad7-46a3-6f965a36ae57",
        "description": "Weapon ignores Hard Target rules when targeting Infantry.",
        "hidden": false,
        "page": 116,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Weapon_MAR:Nexus_Designator",
        "id": "7c57e3a0-58e5-32bc-e5d2-f75138ca17e4",
        "description": "Weapon is used to reduce Sky Drop Markers micro dice.",
        "hidden": false,
        "page": 79,
        "publicationId": "cd17-5d57-pub1"
      },
      {
        "name": "Weapon_MAR:Terror_Weapon",
        "id": "7d85f7b3-bb70-5955-2998-90d7dde550f6",
        "description": "Disorder Tests caused by this weapon roll one less die.",
        "hidden": false,
        "page": 122,
        "publicationId": "cd17-5d57-pub1"
      }
