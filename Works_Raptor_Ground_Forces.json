    "sharedRules": [
      {
        "name": "Aerial_Assault",
        "id": "c613-749d-0a4c-88f9",
        "description": "This Squadron may fire its Main Ordnance while moving Flat Out provided the target squadron are Flying models – These shots are considered to be Rushed",
        "hidden": false,
        "page": 7,
        "publicationId": "34d7-b647-pub1"
      },
      {
        "name": "Cloaked",
        "id": "1d3c-bdb5-1f74-b51d",
        "description": "Explosive Dice (red) ordnance is rolled as Heavy Dice (blue) instead.",
        "hidden": false,
        "page": 116,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Command_Element(16\")",
        "id": "0dbc2ae4-8c5e-a3bd-e9af-5c70610971b5",
        "description": "All helix squadrons in 16\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Dogfighter",
        "id": "8559-239e-d8bc-aa61",
        "description": "This Squadron may ignore the Sectored Armour MAR when targeting Flying models. Flying Target models may therefore suffer Flanking or Rear penalties to their Damage Rating when attacked by a Dogfighter!",
        "hidden": false
      },
      {
        "name": "Flying_Vehicle",
        "id": "926e6d57-4b95-31e5-5cce-2f1282d5c2ed",
        "description": "When moving at Cruising Speed the unit gains Hard Target (-1), when moving at Flat Out the unit gains Hard Target (-2).",
        "hidden": false,
        "page": 118,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Hard_Target(-1)",
        "id": "f69641b9-7a48-9d9e-7020-423c885cf21d",
        "description": "Main Ordnance is -1 to hit this unit.",
        "hidden": false,
        "page": 118,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Hover_Vehicle",
        "id": "a85459e2-b85f-fec7-eb38-615507af1dc4",
        "description": "Vehicles with this MAR is treated as Hard Target (-1) when fired at with weapons in Long Range. This does not combine with other Hard Target rules.",
        "hidden": false,
        "page": 118,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Logistics_Points",
        "id": "96ee851c-9c37-40da-f8ad-cac05dd96d0f",
        "description": "May use up to 5 points to bid on an Opposed Tactics test.",
        "hidden": false,
        "page": 58,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Recon_Specialist",
        "id": "da1f5ad5-1fbd-38e8-30ff-1c5b03a7e223",
        "description": "May move in the Recon Phase.",
        "hidden": false,
        "page": 120,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Sectored_Armour",
        "id": "d81e-c962-096f-c8a4",
        "description": "Model never suffers penalties to DR from Flank or Aft Main Ordnance attacks.",
        "hidden": false,
        "page": 121,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Shadow_Operatives",
        "id": "0ceb6a46-c8da-9a36-c4f3-c0944ddafd54",
        "description": "The Tactical Value Cost to play any Tactical Action Cards by an enemy force increases by 1 while Works Raptor squadrons are present on the battlefield.",
        "hidden": false
      },
      {
        "name": "Take_&_Hold",
        "id": "f798f246-b32a-ec98-bc4f-03996a6b0324",
        "description": "This unit may claim objectives.",
        "hidden": false,
        "page": 121,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Weapon_MAR:Anti-Personnel",
        "id": "614c978a-3d9e-f7d5-f0b2-b54b5cc5d928",
        "description": "Weapon ignores Hard Target rules when targeting Infantry.",
        "hidden": false,
        "page": 116,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Weapon_MAR:Corrosive",
        "id": "1ab7ac22-fcaf-223b-a4d2-d9741ab0201c",
        "description": "Models damaged by this weapon, but not destroyed receive a Debilitating Effect Marker. These markets give -1 DR until repaired. Multiple Markers may be placed, but the effect is not cumulative.",
        "hidden": false,
        "page": 116,
        "publicationId": "34d7-b647-pub2"
      },
      {
        "name": "Weapon_MAR:Interceptor",
        "id": "6d72e33f-b4dc-c8e3-6042-1d84fdb36625",
        "description": "Flying targets do not gain the benefit of Hard Target against these weapons.",
        "hidden": false,
        "page": 119,
        "publicationId": "34d7-b647-pub2"
      }
    ],
