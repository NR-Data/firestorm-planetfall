        "publicationId": "b9ff-fd74-pub2"
      },
      {
        "name": "Cloaked",
        "id": "e494-fa7e-a647-762a",
        "description": "Explosive Dice (red) ordnance is rolled as Heavy Dice (blue) instead.",
        "hidden": false,
        "page": 116,
        "publicationId": "b9ff-fd74-pub1"
      },
      {
        "name": "Command_Centre",
        "id": "7b19-63d3-964d-b166",
        "description": "A Force that contains this model may take an ADDITIONAL Tactical Action Card over and above the number stated for the game size.",
        "hidden": false,
        "page": 11,
        "publicationId": "b9ff-fd74-pub3"
      },
      {
        "name": "Command_Element(12\")",
        "id": "e5e5c646-f5bc-5c85-8af0-b10457704edc",
        "description": "All helix squadrons in 12\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "b9ff-fd74-pub1"
      },
      {"name": "Conditional_Deployment", "id": "8846-34c0-0025-98ab", "description": "Seraph Squadrons MUST be deployed via a Temple of Dramos.", "hidden": false},
      {
        "name": "Drone",
        "id": "064598f7-0c15-ec8a-aacf-fb40d8519488",
        "description": "Drones within range of a Drone Nexus become Regular and gain +1 CQB.",
        "hidden": false,
        "page": 117,
        "publicationId": "b9ff-fd74-pub1"
      },
      {
        "name": "Drone_Nexus(12\")",
        "id": "a4c7-b0b5-7aaf-dfdd",
        "description": "Boosts Drones to Regular and gives them +1 CQB within 12\". Each point of damage lowers the Nexus range by 4\".",
        "hidden": false,
        "page": 117,
        "publicationId": "b9ff-fd74-pub1"
      },
      {
        "name": "Drone_Nexus(8\")",
        "id": "d22fe4d8-71d2-b293-38cf-b5db9f768a1d",
        "description": "Boosts Drones to Regular and gives them +1 CQB within 8\". Each point of damage lowers the Nexus range by 4\".",
        "hidden": false,
        "page": 117,
        "publicationId": "b9ff-fd74-pub1"
      },
      {
