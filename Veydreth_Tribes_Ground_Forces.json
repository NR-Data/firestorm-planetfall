    "sharedRules": [
      {
        "name": "Artillery_Support(1)",
        "id": "20448c6d-96ee-1465-dfaf-2faa1239aec8",
        "description": "May use the Artillery Support rules on Page 82.",
        "hidden": false,
        "page": 116,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Command_Element(8\")",
        "id": "0dbc2ae4-8c5e-a3bd-e9af-5c70610971b5",
        "description": "All helix squadrons in 8\" gain an additional morale die when testing for disorder. If this model is detroyed all squadrons in the helix must take a disorder test requiring two successes.",
        "hidden": false,
        "page": 116,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Dark_Stone_Targeting_Array",
        "id": "fa01-f9ce-e0c4-bc87",
        "description": "When performing a Target Lock Action, a Yok-Ta may re-roll any Initial rolls of a 1.",
        "hidden": false,
        "page": 9,
        "publicationId": "37d6-1c53-pub2"
      },
      {
        "name": "Hard_Target(-1)",
        "id": "f69641b9-7a48-9d9e-7020-423c885cf21d",
        "description": "Main Ordnance is -1 to hit this unit.",
        "hidden": false,
        "page": 118,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Hover_Vehicle",
        "id": "a85459e2-b85f-fec7-eb38-615507af1dc4",
        "description": "Vehicles with this MAR is treated as Hard Target (-1) when fired at with weapons in Long Range. This does not combine with other Hard Target rules.",
        "hidden": false,
        "page": 118,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Logistics_Points",
        "id": "96ee851c-9c37-40da-f8ad-cac05dd96d0f",
        "description": "May use up to 4 points to bid on an Opposed Tactics test.",
        "hidden": false,
        "page": 58,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Recon_Specialist",
        "id": "da1f5ad5-1fbd-38e8-30ff-1c5b03a7e223",
        "description": "The Squadron chosen may choose to make a free Flat Out Movement Action during the Recon Phase provided the move does not bring the Element within 16\" of an enemy Model at any time during its movement.",
        "hidden": false,
        "page": 120,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Supreme_Hunters",
        "id": "1d9d980a-371e-0ac9-c27e-983297d7e2a4",
        "description": "Any Veydreth Attacks using Pinpoint Weapons during a Main Ordnance Attack may re-roll a single dice when determining if a Pinpoint Attack has successful.",
        "hidden": false,
        "page": 2,
        "publicationId": "37d6-1c53-pub3"
      },
      {
        "name": "Target_Lock",
        "id": "25015a86-21a2-911a-aa69-6f9a20620507",
        "description": "May use Nexus Designator to target an enemy unit befor the rest of the unit fires Main Ordnance. 0-3 hits : No Effect. 4+ Hits : Firing Squadron gains a placed bonus when firing their Main Ordnance.",
        "hidden": false,
        "page": 122,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Weapon_MAR:Nexus_Designator",
        "id": "b372d823-80b5-4b48-f2e0-f990abd5304a",
        "description": "Weapon is used to reduce Sky Drop Markers micro dice.",
        "hidden": false,
        "page": 79,
        "publicationId": "37d6-1c53-pub1"
      },
      {
        "name": "Weapon_MAR:Pinpoint(1)",
        "id": "5db56ae3-2cea-496d-291b-16c428c5d305",
        "description": "If a Pinpoint weapon damages, but fails to destroy non-infantry, roll 1d6. If a 6 is rolled, the target suffers an additional point of damage. If multiple weapons combine with Pinpoint, use the highest value only.",
        "hidden": false,
        "page": 119,
        "publicationId": "37d6-1c53-pub1"
      }
    ],
